#!/usr/bin/env bash
set -euo pipefail
# Resolve this script through any symlinks before deriving the repo root. Putting
# remrun on PATH means symlinking this launcher into ~/.local/bin (or similar), and
# a bare `dirname "${BASH_SOURCE[0]}"` would then resolve to the symlink's directory
# — making REMRUN_ROOT ~/.local, which has no src/, so `python -m remrun.cli` fails
# with ModuleNotFoundError. Walk the link chain instead. (No `readlink -f`: BSD/macOS
# readlink lacks it.)
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK_DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  # A relative link target is relative to the directory holding the link.
  case "$SELF" in /*) ;; *) SELF="$LINK_DIR/$SELF" ;; esac
done
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
REMRUN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
export REMRUN_ROOT
export PYTHONPATH="$REMRUN_ROOT/src:${PYTHONPATH:-}"
# The project requires Python 3.11+. Some macOS hosts expose Apple's older
# /usr/bin/python3 before a compatible Homebrew or project-tools interpreter.
# Validate candidates instead of accepting the first executable named python3.
python_is_compatible() {
  [ -n "$1" ] && [ -x "$1" ] &&
    "$1" -c 'import sys; raise SystemExit(sys.version_info < (3, 11))' \
      >/dev/null 2>&1
}

if [ -n "${REMRUN_PYTHON:-}" ]; then
  if ! python_is_compatible "$REMRUN_PYTHON"; then
    echo "remrun: REMRUN_PYTHON must be an executable Python 3.11+" >&2
    exit 1
  fi
  PY="$REMRUN_PYTHON"
else
  PY=""
  CANDIDATES=()
  for NAME in python3 python3.14 python3.13 python3.12 python3.11; do
    CANDIDATE="$(command -v "$NAME" 2>/dev/null || true)"
    [ -n "$CANDIDATE" ] && CANDIDATES+=("$CANDIDATE")
  done
  if [ -n "${HOME:-}" ]; then
    CANDIDATES+=("$HOME/venvs/remrun/bin/python")
  fi
  CANDIDATES+=(
    /opt/homebrew/bin/python3
    /usr/local/bin/python3
  )
  CANDIDATE="$(command -v python 2>/dev/null || true)"
  [ -n "$CANDIDATE" ] && CANDIDATES+=("$CANDIDATE")

  for CANDIDATE in "${CANDIDATES[@]}"; do
    if python_is_compatible "$CANDIDATE"; then
      PY="$CANDIDATE"
      break
    fi
  done
  if [ -z "$PY" ]; then
    echo "remrun: Python 3.11+ required; set REMRUN_PYTHON or create ~/venvs/remrun" >&2
    exit 1
  fi
fi
exec "$PY" -m remrun.cli "$@"
