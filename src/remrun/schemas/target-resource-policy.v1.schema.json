{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smkwray/remrun/schemas/target-resource-policy.v1.schema.json",
  "title": "remrun target resource policy v1",
  "type": "object",
  "required": ["schema", "version", "generation", "resources"],
  "properties": {
    "schema": {"const": "remrun.target-resource-policy"},
    "version": {"const": 1},
    "generation": {"type": "integer", "minimum": 1},
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["key", "capacity"],
        "properties": {
          "key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
          "capacity": {"const": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
