{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smkwray/remrun/schemas/error.v1.schema.json",
  "title": "remrun protocol error v1",
  "type": "object",
  "required": ["schema", "version", "code", "message", "retryable"],
  "properties": {
    "schema": {"const": "remrun.error"},
    "version": {"const": 1},
    "code": {"type": "string", "minLength": 1},
    "message": {"type": "string", "minLength": 1},
    "retryable": {"type": "boolean"}
  },
  "additionalProperties": true
}
